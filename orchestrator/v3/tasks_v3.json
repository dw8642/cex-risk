    "Q-05": { "agent": "Q", "title": "告警端到端：RiskEvent→Telegram",                      "hours": 2.4, "depends": ["gate-4"], "gate_unlock": null,     "sprint": 3 },
    "Q-06": { "agent": "Q", "title": "健康度测试：降级→Hard Cap→状态机",                     "hours": 4,   "depends": ["gate-4"], "gate_unlock": null,     "sprint": 3 },
