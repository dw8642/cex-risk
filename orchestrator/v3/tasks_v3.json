  "sprints": {
    "0": { "name": "Sprint 0: 基座 + 前端脚手架", "days": "Day 1~4",   "target_gate": "gate-1", "active_agents": ["F", "W"] },
    "1": { "name": "Sprint 1: 数据 + 指标 + 规则框架", "days": "Day 3~10",  "target_gate": "gate-2", "active_agents": ["D", "I", "R", "S", "W", "Q"] },
    "2": { "name": "Sprint 2: 指标 + 规则 + 联调",     "days": "Day 8~14",  "target_gate": "gate-3,gate-4", "active_agents": ["D", "I", "R", "Q"] },
    "3": { "name": "Sprint 3: Dashboard 读取 API",      "days": "Day 12~18", "target_gate": "gate-5", "active_agents": ["R", "W", "Q"] },
    "4": { "name": "Sprint 4: 配置 API + RBAC + 联调",  "days": "Day 16~22", "target_gate": "gate-6", "active_agents": ["W", "Q"] },
